@model GestionTicketsCombustible.Application.CierresDiarios.PrepararCierreDiarioDto

@{
    ViewData["Title"] = "Preparar Cierre Diario";
}

<h1>Cierre Diario — @Model.Fecha.ToString("d")</h1>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<p class="text-muted">
    Ingresa la lectura fisica de cada tanque activo. La existencia teorica y los totales del dia
    se recalculan automaticamente al momento de confirmar.
</p>

<form asp-action="Confirmar" method="post">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Tanque</th>
                <th>Existencia teorica (sistema)</th>
                <th>Despachado hoy</th>
                <th>Recibido hoy</th>
                <th>Existencia fisica (lectura manual)</th>
            </tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Tanques.Count; i++)
            {
                var t = Model.Tanques[i];
                <tr>
                    <td>
                        @t.TanqueNombre
                        <input type="hidden" name="LecturasFisicas[@i].TanqueId" value="@t.TanqueId" />
                    </td>
                    <td>@t.ExistenciaTeorica.ToString("N2")</td>
                    <td>@t.DespachadoDia.ToString("N2")</td>
                    <td>@t.RecibidoDia.ToString("N2")</td>
                    <td>
                        <input type="number" step="0.01" class="form-control"
                               name="LecturasFisicas[@i].ExistenciaFisica" required />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mb-3">
        <label for="Observaciones" class="form-label">Observaciones (opcional)</label>
        <textarea name="Observaciones" id="Observaciones" class="form-control" rows="2"></textarea>
    </div>

    <button type="submit" class="btn btn-primary"
            onclick="return confirm('¿Confirmar el cierre diario? Esta accion no se puede deshacer.');">
        Confirmar Cierre
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>