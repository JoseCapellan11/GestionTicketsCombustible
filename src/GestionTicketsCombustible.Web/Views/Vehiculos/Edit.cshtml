@model GestionTicketsCombustible.Application.Vehiculos.VehiculoDto

@{
    ViewData["Title"] = "Editar Vehiculo";
}

<h1>Editar Vehículo</h1>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label">Placa</label>
        <input asp-for="Placa" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Ficha</label>
        <input asp-for="Ficha" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Marca</label>
        <input asp-for="Marca" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Modelo</label>
        <input asp-for="Modelo" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Año</label>
        <input asp-for="Anio" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Tipo</label>
        <input asp-for="Tipo" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Departamento</label>
        <select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label class="form-label">Capacidad del Tanque (galones)</label>
        <input asp-for="CapacidadTanque" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Kilometraje</label>
        <input asp-for="Kilometraje" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>