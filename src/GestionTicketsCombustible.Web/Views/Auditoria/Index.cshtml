@model List<GestionTicketsCombustible.Application.Auditoria.AuditoriaLogDto>

@{
    ViewData["Title"] = "Auditoria";
}

<h1>Trazabilidad / Auditoria</h1>
<p class="text-muted">Mostrando los 500 registros mas recientes.</p>

<table class="table table-sm">
    <thead>
        <tr>
            <th>Fecha y Hora</th>
            <th>Usuario</th>
            <th>Accion</th>
            <th>Entidad</th>
            <th>Id</th>
            <th>Descripcion</th>
            <th>IP</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var log in Model)
        {
            <tr>
                <td>@log.FechaHora.ToString("dd/MM/yyyy HH:mm:ss")</td>
                <td>@log.NombreUsuarioSnapshot</td>
                <td>@log.TipoAccion</td>
                <td>@log.Entidad</td>
                <td>@(log.EntidadId?.ToString() ?? "-")</td>
                <td>@log.Descripcion</td>
                <td>@log.DireccionIp</td>
            </tr>
        }
    </tbody>
</table>