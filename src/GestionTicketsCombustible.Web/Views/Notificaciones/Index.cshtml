@model List<GestionTicketsCombustible.Application.Notificaciones.NotificacionDto>

@{
    ViewData["Title"] = "Notificaciones";
}

<h1>Notificaciones</h1>

<form asp-action="MarcarTodasLeidas" method="post" class="mb-3">
    <button type="submit" class="btn btn-outline-secondary btn-sm">Marcar todas como leídas</button>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Tipo</th>
            <th>Mensaje</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model)
        {
            <tr class="@(n.Leida ? "" : "table-warning")">
                <td>@n.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@n.Tipo</td>
                <td>@n.Mensaje</td>
                <td>
                    @if (!n.Leida)
                    {
                        <form asp-action="MarcarLeida" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-primary">Marcar leída</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No hay notificaciones todavía.</p>
}