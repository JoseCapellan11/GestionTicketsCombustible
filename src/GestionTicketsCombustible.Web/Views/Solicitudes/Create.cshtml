@using GestionTicketsCombustible.Domain.Enums
@model GestionTicketsCombustible.Application.Solicitudes.CrearSolicitudDto

@{
    ViewData["Title"] = "Nueva Solicitud de Combustible";
}

<h1>Nueva Solicitud de Combustible</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label asp-for="EmpleadoId"></label>
        <select asp-for="EmpleadoId" asp-items="ViewBag.Empleados" class="form-control">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="EmpleadoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="VehiculoId"></label>
        <select asp-for="VehiculoId" asp-items="ViewBag.Vehiculos" class="form-control">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="VehiculoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="DepartamentoId"></label>
        <select asp-for="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-control">
            <option value="">-- Selecciona --</option>
        </select>
        <span asp-validation-for="DepartamentoId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="CantidadAutorizada"></label>
        <input asp-for="CantidadAutorizada" class="form-control" />
        <span asp-validation-for="CantidadAutorizada" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TipoCombustible"></label>
        <input asp-for="TipoCombustible" class="form-control" />
        <span asp-validation-for="TipoCombustible" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="TipoSolicitud"></label>
        <select asp-for="TipoSolicitud" asp-items="Html.GetEnumSelectList<TipoSolicitud>()" class="form-control"></select>
    </div>

    <div class="form-group">
        <label asp-for="FechaVencimiento"></label>
        <input asp-for="FechaVencimiento" type="datetime-local" class="form-control" />
        <span asp-validation-for="FechaVencimiento" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Crear Solicitud</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}